import streamlit as st

st.set_page_config(page_title="Checklist Esc. Expl.", page_icon="🪖")

st.title("🪖 Control de Mantenimiento")
st.write("Registro de inspección para vehículos del Escuadrón de Exploración.")

# --- EL CHECKLIST ---
st.header("📋 Lista de Verificación")

# Sección Mecánica
with st.expander("1. Motor y Fluidos", expanded=True):
    aceite = st.radio("Nivel de aceite:", ["Correcto", "Bajo", "Excesivo"], horizontal=True)
    fugas = st.checkbox("¿Hay fugas de fluidos visibles?")
    liquido_refr = st.toggle("Nivel de refrigerante OK")

# Sección Eléctrica
with st.expander("2. Sistema Eléctrico"):
    luces = st.multiselect("Luces operativas:", ["Bajas", "Altas", "Freno", "Giro", "Oscurecimiento"])
    bateria = st.select_slider("Estado de carga batería:", options=["Baja", "Media", "Óptima"])

# Sección Táctica
with st.expander("3. Equipo del Escuadrón"):
    radio = st.radio("Comunicaciones (VHF/UHF):", ["Operativo", "Falla", "N/A"])
    combustible = st.slider("Nivel de combustible (%)", 0, 100, 50)
    novedades = st.text_area("Observaciones adicionales:")

if st.button("Guardar Inspección"):
    st.success("Inspección registrada correctamente.")
    st.balloons()
